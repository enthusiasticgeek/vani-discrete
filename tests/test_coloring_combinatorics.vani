// Tests for greedy coloring (G5) and combinatorics enumeration (G6, G7).
// Includes composed checks: the total count of permutations/combinations
// generated by repeated disc_next_permutation/disc_next_combination calls
// must match the compiler's own builtin counting functions
// (i64_factorial, i64_binomial) -- cross-checking enumeration against an
// independent ground truth, not just eyeballing plausible output.
// Run with:  vanic test tests/test_coloring_combinatorics.vani

use "../src/lib.vani";

fn main() -> i64 {
    // 4-cycle: 0-1-2-3-0, bipartite, chromatic number 2.
    let n1: i64 = 4;
    let adj1: Vec<f64> = disc_adj_new(n1);
    disc_adj_add_edge_undirected(mut ref adj1, n1, 0, 1, 1.0);
    disc_adj_add_edge_undirected(mut ref adj1, n1, 1, 2, 1.0);
    disc_adj_add_edge_undirected(mut ref adj1, n1, 2, 3, 1.0);
    disc_adj_add_edge_undirected(mut ref adj1, n1, 3, 0, 1.0);
    let c1: Vec<i64> = disc_greedy_coloring(ref adj1, n1);
    assert c1[0] != c1[1];
    assert c1[1] != c1[2];
    assert c1[2] != c1[3];
    assert c1[3] != c1[0];

    // Triangle: requires 3 distinct colors (odd cycle).
    let n2: i64 = 3;
    let adj2: Vec<f64> = disc_adj_new(n2);
    disc_adj_add_edge_undirected(mut ref adj2, n2, 0, 1, 1.0);
    disc_adj_add_edge_undirected(mut ref adj2, n2, 1, 2, 1.0);
    disc_adj_add_edge_undirected(mut ref adj2, n2, 2, 0, 1.0);
    let c2: Vec<i64> = disc_greedy_coloring(ref adj2, n2);
    assert c2[0] != c2[1];
    assert c2[1] != c2[2];
    assert c2[0] != c2[2];

    // disc_exact_coloring finds the TRUE chromatic number, not just a
    // valid coloring: the 4-cycle is bipartite (chromatic number exactly
    // 2), and the triangle is an odd cycle (provably NOT 2-colorable,
    // chromatic number exactly 3).
    let ec1: Vec<i64> = disc_exact_coloring(ref adj1, n1);
    assert ec1[0] != ec1[1];
    assert ec1[1] != ec1[2];
    assert ec1[2] != ec1[3];
    assert ec1[3] != ec1[0];
    let max_c1: i64 = 0;
    let ci: i64 = 0;
    while ci < n1 {
        if ec1[ci] > max_c1 { max_c1 = ec1[ci]; }
        ci = ci + 1;
    }
    assert max_c1 == 1;

    let ec2: Vec<i64> = disc_exact_coloring(ref adj2, n2);
    assert ec2[0] != ec2[1];
    assert ec2[1] != ec2[2];
    assert ec2[0] != ec2[2];
    let max_c2: i64 = 0;
    ci = 0;
    while ci < n2 {
        if ec2[ci] > max_c2 { max_c2 = ec2[ci]; }
        ci = ci + 1;
    }
    assert max_c2 == 2;

    // Composed check: permutations of [0,1,2,3] generated by
    // disc_next_permutation must total i64_factorial(4) = 24.
    let perm: Vec<i64> = vec();
    push(mut ref perm, 0); push(mut ref perm, 1); push(mut ref perm, 2); push(mut ref perm, 3);
    let perm_count: i64 = 1;
    let has_next: bool = disc_next_permutation(mut ref perm);
    while has_next {
        perm_count = perm_count + 1;
        has_next = disc_next_permutation(mut ref perm);
    }
    assert perm_count == i64_factorial(4);
    // Must have returned to the starting (ascending) order... actually
    // std::next_permutation-style wraps to ascending on the final call
    // returning false, but doesn't restore it -- verify count only.

    // Composed check: 3-combinations of {0..5} generated by
    // disc_next_combination must total i64_binomial(6,3) = 20.
    let combo: Vec<i64> = vec();
    push(mut ref combo, 0); push(mut ref combo, 1); push(mut ref combo, 2);
    let combo_count: i64 = 1;
    let has_next_c: bool = disc_next_combination(mut ref combo, 6);
    while has_next_c {
        combo_count = combo_count + 1;
        has_next_c = disc_next_combination(mut ref combo, 6);
    }
    assert combo_count == i64_binomial(6, 3);

    // subset_from_bitmask: mask 0b1011 = 11 over n=4 -> {0,1,3}.
    let sub: Vec<i64> = disc_subset_from_bitmask(11, 4);
    assert (len(ref sub) as i64) == 3;
    assert sub[0] == 0;
    assert sub[1] == 1;
    assert sub[2] == 3;

    // Composed check: summing disc_subset_from_bitmask's length over every
    // mask 0..2^4-1 must equal n * 2^(n-1) (each of the 4 elements appears
    // in exactly half of all subsets).
    let total_elems: i64 = 0;
    let mask: i64 = 0;
    while mask < 16 {
        let s: Vec<i64> = disc_subset_from_bitmask(mask, 4);
        total_elems = total_elems + (len(ref s) as i64);
        mask = mask + 1;
    }
    assert total_elems == 4 * 8;

    // Partition counts against known values.
    assert disc_partition_count(0) == 1;
    assert disc_partition_count(5) == 7;
    assert disc_partition_count(6) == 11;
    assert disc_partition_count(7) == 15;

    return 0;
}
