// Tests for max-flow/min-cut (G3) and bipartite matching (G4). Includes a
// composed check: the min cut's capacity (summed from the original
// capacity matrix, not the residual) must equal the max flow value --
// the max-flow-min-cut theorem, verified rather than assumed.
// Run with:  vanic test tests/test_flow_matching.vani

use "../src/lib.vani";

fn close(a: f64, b: f64) -> bool {
    return abs(a - b) < 1.0e-9;
}

fn main() -> i64 {
    // Classic CLRS max-flow example: max flow = 23.
    let n: i64 = 6;
    let cap: Vec<f64> = disc_adj_new(n);
    disc_adj_add_edge(mut ref cap, n, 0, 1, 16.0);
    disc_adj_add_edge(mut ref cap, n, 0, 2, 13.0);
    disc_adj_add_edge(mut ref cap, n, 1, 2, 10.0);
    disc_adj_add_edge(mut ref cap, n, 1, 3, 12.0);
    disc_adj_add_edge(mut ref cap, n, 2, 1, 4.0);
    disc_adj_add_edge(mut ref cap, n, 2, 4, 14.0);
    disc_adj_add_edge(mut ref cap, n, 3, 2, 9.0);
    disc_adj_add_edge(mut ref cap, n, 3, 5, 20.0);
    disc_adj_add_edge(mut ref cap, n, 4, 3, 7.0);
    disc_adj_add_edge(mut ref cap, n, 4, 5, 4.0);

    let result: MaxFlowResult = disc_max_flow(ref cap, n, 0, 5);
    assert close(result.flow, 23.0);

    // Composed check: max-flow-min-cut theorem, cross-checked against the
    // ORIGINAL capacity matrix, not just the residual the flow computed.
    let side: Vec<i64> = disc_min_cut_nodes(ref result.residual, n, 0);
    assert side[5] == 0;
    let cut_capacity: f64 = 0.0;
    let i: i64 = 0;
    while i < n {
        let j: i64 = 0;
        while j < n {
            if side[i] == 1 && side[j] == 0 {
                if cap[i * n + j] < f64_inf() {
                    cut_capacity = cut_capacity + cap[i * n + j];
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    assert close(cut_capacity, result.flow);

    // Bipartite matching: Left{0,1}, Right{0,1}, edges 0-0, 0-1, 1-0.
    // Requires an augmenting-path swap to reach the true maximum of 2
    // (naive greedy without augmenting would only find 1).
    let n_left: i64 = 2;
    let n_right: i64 = 2;
    let inf: f64 = f64_inf();
    let bip: Vec<f64> = vec();
    push(mut ref bip, 1.0); push(mut ref bip, 1.0);
    push(mut ref bip, 1.0); push(mut ref bip, inf);

    let match_right: Vec<i64> = disc_bipartite_matching(ref bip, n_left, n_right);
    let matched: i64 = 0;
    i = 0;
    while i < n_right {
        if match_right[i] != 0 - 1 {
            matched = matched + 1;
        }
        i = i + 1;
    }
    assert matched == 2;

    return 0;
}
