// Tests for Floyd-Warshall (G1) and Kosaraju SCC (G2).
// Run with:  vanic test tests/test_graph_paths.vani

use "../src/lib.vani";

fn close(a: f64, b: f64) -> bool {
    return abs(a - b) < 1.0e-9;
}

fn main() -> i64 {
    // 4-node graph: 0->1(3), 1->2(1), 2->3(2), 0->3(10) direct.
    let n: i64 = 4;
    let adj: Vec<f64> = disc_adj_new(n);
    disc_adj_add_edge(mut ref adj, n, 0, 1, 3.0);
    disc_adj_add_edge(mut ref adj, n, 1, 2, 1.0);
    disc_adj_add_edge(mut ref adj, n, 2, 3, 2.0);
    disc_adj_add_edge(mut ref adj, n, 0, 3, 10.0);

    let dist: Vec<f64> = disc_floyd_warshall(ref adj, n);
    assert close(dist[0 * n + 3], 6.0);
    assert close(dist[0 * n + 2], 4.0);
    assert close(dist[1 * n + 3], 3.0);
    assert dist[3 * n + 0] >= f64_inf();
    assert close(dist[0 * n + 0], 0.0);

    // 5-node graph with two SCCs: {0,1,2} (cycle) and {3,4} (cycle),
    // connected 1->3 one-way.
    let n2: i64 = 5;
    let adj2: Vec<f64> = disc_adj_new(n2);
    disc_adj_add_edge(mut ref adj2, n2, 0, 1, 1.0);
    disc_adj_add_edge(mut ref adj2, n2, 1, 2, 1.0);
    disc_adj_add_edge(mut ref adj2, n2, 2, 0, 1.0);
    disc_adj_add_edge(mut ref adj2, n2, 1, 3, 1.0);
    disc_adj_add_edge(mut ref adj2, n2, 3, 4, 1.0);
    disc_adj_add_edge(mut ref adj2, n2, 4, 3, 1.0);

    let comp: Vec<i64> = disc_scc_kosaraju(ref adj2, n2);
    assert comp[0] == comp[1];
    assert comp[1] == comp[2];
    assert comp[3] == comp[4];
    assert comp[0] != comp[3];

    return 0;
}
